{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillViewer",
  "version": "0.1.0",
  "identifier": "com.skillviewer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Viewer - Claude Skills 管理器",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https://ark.cn-beijing.volces.com https://*.volces.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SkillViewer",
    "homepage": "https://github.com/your-repo/skillviewer",
    "shortDescription": "Claude Skills 管理器 - 浏览、搜索、翻译和总结你的 Claude Code Skills",
    "longDescription": "一个本地桌面应用程序，用于管理 Claude Code Skills，支持浏览、搜索、调用 AI 翻译和总结技能。",
    "category": "Utility",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
